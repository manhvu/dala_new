// beam_jni.c — JNI entry points for <%= display_name %>.
// Generated by mix dala.new. Edit the two defines below; do not touch the rest.

#include <jni.h>
#include "dala_beam.h"

#define BRIDGE_CLASS  "<%= java_path %>/DalaBridge"
#define APP_MODULE    "<%= app_name %>"

JavaVM* g_jvm      = NULL;
jobject g_activity = NULL;

JNIEXPORT jint JNI_OnLoad(JavaVM* vm, void* reserved) {
    g_jvm = vm;
    JNIEnv* env;
    (*vm)->GetEnv(vm, (void**)&env, JNI_VERSION_1_6);
    dala_ui_cache_class(env, BRIDGE_CLASS);
    return JNI_VERSION_1_6;
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_MainActivity_nativeSetActivity(JNIEnv* env, jobject thiz, jobject activity) {
    dala_init_bridge(env, activity);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_MainActivity_nativeStartBeam(JNIEnv* env, jobject thiz) {
    dala_start_beam(APP_MODULE);
}

// Called from DalaBridge.nativeSendTap(handle) in Kotlin when a button is tapped.
JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendTap(JNIEnv* env, jclass cls, jint handle) {
    dala_send_tap((int)handle);
}

// Called from DalaBridge.nativeSendChangeStr/Bool/Float when an input widget changes.
JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendChangeStr(JNIEnv* env, jclass cls, jint handle, jstring value) {
    const char* utf8 = (*env)->GetStringUTFChars(env, value, NULL);
    dala_send_change_str((int)handle, utf8);
    (*env)->ReleaseStringUTFChars(env, value, utf8);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendChangeBool(JNIEnv* env, jclass cls, jint handle, jboolean value) {
    dala_send_change_bool((int)handle, (int)value);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendChangeFloat(JNIEnv* env, jclass cls, jint handle, jfloat value) {
    dala_send_change_float((int)handle, (double)value);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendFocus(JNIEnv* env, jclass cls, jint handle) {
    dala_send_focus((int)handle);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendBlur(JNIEnv* env, jclass cls, jint handle) {
    dala_send_blur((int)handle);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSendSubmit(JNIEnv* env, jclass cls, jint handle) {
    dala_send_submit((int)handle);
}

// Called from DalaBridge.nativeHandleBack() when the Android back gesture fires.
JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeHandleBack(JNIEnv* env, jclass cls) {
    dala_handle_back();
}

// Called from DalaBridge.notifyColorSchemeChanged when MainActivity's
// onConfigurationChanged sees a uiMode flip. `scheme` is "light" or "dark".
JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeNotifyColorScheme(JNIEnv* env, jclass cls,
    jstring scheme) {
    if (!scheme) return;
    const char* utf8 = (*env)->GetStringUTFChars(env, scheme, NULL);
    if (utf8) {
        dala_send_color_scheme_changed(utf8);
        (*env)->ReleaseStringUTFChars(env, scheme, utf8);
    }
}

// ── Device capability result delivery ────────────────────────────────────
// Called from DalaBridge when async results are ready.

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverAtom2(JNIEnv* env, jclass cls,
    jlong pid, jstring a1, jstring a2) {
    const char* ca1 = (*env)->GetStringUTFChars(env, a1, NULL);
    const char* ca2 = (*env)->GetStringUTFChars(env, a2, NULL);
    dala_deliver_atom2(pid, ca1, ca2);
    (*env)->ReleaseStringUTFChars(env, a1, ca1);
    (*env)->ReleaseStringUTFChars(env, a2, ca2);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverAtom3(JNIEnv* env, jclass cls,
    jlong pid, jstring a1, jstring a2, jstring a3) {
    const char* ca1 = (*env)->GetStringUTFChars(env, a1, NULL);
    const char* ca2 = (*env)->GetStringUTFChars(env, a2, NULL);
    const char* ca3 = (*env)->GetStringUTFChars(env, a3, NULL);
    dala_deliver_atom3(pid, ca1, ca2, ca3);
    (*env)->ReleaseStringUTFChars(env, a1, ca1);
    (*env)->ReleaseStringUTFChars(env, a2, ca2);
    (*env)->ReleaseStringUTFChars(env, a3, ca3);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverLocation(JNIEnv* env, jclass cls,
    jlong pid, jdouble lat, jdouble lon, jdouble acc, jdouble alt) {
    dala_deliver_location(pid, lat, lon, acc, alt);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverMotion(JNIEnv* env, jclass cls,
    jlong pid, jdouble ax, jdouble ay, jdouble az,
    jdouble gx, jdouble gy, jdouble gz, jlong ts) {
    dala_deliver_motion(pid, ax, ay, az, gx, gy, gz, (long long)ts);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverFileResult(JNIEnv* env, jclass cls,
    jlong pid, jstring event, jstring sub, jstring json_items) {
    const char* ce  = (*env)->GetStringUTFChars(env, event, NULL);
    const char* cs  = (*env)->GetStringUTFChars(env, sub,   NULL);
    const char* cj  = json_items ? (*env)->GetStringUTFChars(env, json_items, NULL) : NULL;
    dala_deliver_file_result(pid, ce, cs, cj);
    (*env)->ReleaseStringUTFChars(env, event, ce);
    (*env)->ReleaseStringUTFChars(env, sub,   cs);
    if (cj) (*env)->ReleaseStringUTFChars(env, json_items, cj);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverPushToken(JNIEnv* env, jclass cls,
    jlong pid, jstring token) {
    const char* ct = (*env)->GetStringUTFChars(env, token, NULL);
    dala_deliver_push_token(pid, ct);
    (*env)->ReleaseStringUTFChars(env, token, ct);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverNotification(JNIEnv* env, jclass cls,
    jlong pid, jstring json) {
    const char* cj = (*env)->GetStringUTFChars(env, json, NULL);
    dala_deliver_notification(pid, cj);
    (*env)->ReleaseStringUTFChars(env, json, cj);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeSetLaunchNotification(JNIEnv* env, jclass cls,
    jstring json) {
    if (!json) { dala_set_launch_notification(NULL); return; }
    const char* cj = (*env)->GetStringUTFChars(env, json, NULL);
    dala_set_launch_notification(cj);
    (*env)->ReleaseStringUTFChars(env, json, cj);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverWebViewMessage(JNIEnv* env, jclass cls,
    jlong pid, jstring json) {
    const char* cj = (*env)->GetStringUTFChars(env, json, NULL);
    dala_deliver_webview_message(pid, cj);
    (*env)->ReleaseStringUTFChars(env, json, cj);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverWebViewBlocked(JNIEnv* env, jclass cls,
    jlong pid, jstring url) {
    const char* cu = (*env)->GetStringUTFChars(env, url, NULL);
    dala_deliver_webview_blocked(pid, cu);
    (*env)->ReleaseStringUTFChars(env, url, cu);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverAlertAction(JNIEnv* env, jclass cls,
    jstring action) {
    const char* ca = (*env)->GetStringUTFChars(env, action, NULL);
    dala_deliver_alert_action(ca);
    (*env)->ReleaseStringUTFChars(env, action, ca);
}

JNIEXPORT void JNICALL
Java_<%= jni_package %>_DalaBridge_nativeDeliverComponentEvent(JNIEnv* env, jclass cls,
    jint handle, jstring event, jstring payload_json) {
    const char* ce = (*env)->GetStringUTFChars(env, event,        NULL);
    const char* cj = (*env)->GetStringUTFChars(env, payload_json, NULL);
    dala_send_component_event((int)handle, ce, cj);
    (*env)->ReleaseStringUTFChars(env, event,        ce);
    (*env)->ReleaseStringUTFChars(env, payload_json, cj);
}
