defmodule <%= module_name %>.TextScreen do
  @moduledoc "Text input demo screen."
  use Dala.Screen

  def mount(_params, _session, socket) do
    text = Dala.State.get(:draft_text, "")
    {:ok, Dala.Socket.assign(socket, text: text, focused: false, char_count: String.length(text))}
  end

  def render(assigns) do
    char_label = "#{assigns.char_count} character#{if assigns.char_count == 1, do: "", else: "s"}"
    preview_text = if assigns.text == "", do: "Your text will appear here…", else: assigns.text
    preview_color = if assigns.text == "", do: :muted, else: :on_surface

    Dala.UI.scroll([background: :background], [
      Dala.UI.column([background: :background, padding: :space_md], [
        header("✏️  Text Input"),
        Dala.UI.spacer(size: 24),

        # ── Input field ──────────────────────────────────────────────
        Dala.UI.text_field(
          text: assigns.text,
          placeholder: "Type something…",
          keyboard_type: :default,
          return_key: :done,
          on_change: {self(), :text_changed},
          on_focus: {self(), :focused},
          on_blur: {self(), :blurred}
        ),
        Dala.UI.spacer(size: 8),
        Dala.UI.text(text: char_label, text_size: :sm, text_color: :muted, padding: 4),

        Dala.UI.spacer(size: 24),
        Dala.UI.divider(color: :border),
        Dala.UI.spacer(size: 16),

        # ── Echo box ─────────────────────────────────────────────────
        Dala.UI.text(text: "Preview", text_size: :sm, text_color: :muted, padding: :space_sm),
        Dala.UI.box([background: :surface_raised, padding: :space_md], [
          Dala.UI.text(text: preview_text, text_size: :lg, text_color: preview_color, padding: 0)
        ]),

        Dala.UI.spacer(size: 32),
        back_button()
      ])
    ])
  end

  def handle_info({:change, :text_changed, value}, socket) do
    # Dala.State.put/2 syncs to disk on every call — fine for short text.
    # For heavier values, debounce writes using Process.send_after/3 instead.
    Dala.State.put(:draft_text, value)
    {:noreply, Dala.Socket.assign(socket, text: value, char_count: String.length(value))}
  end

  def handle_info({:focus, :focused}, socket) do
    {:noreply, Dala.Socket.assign(socket, :focused, true)}
  end

  def handle_info({:blur, :blurred}, socket) do
    {:noreply, Dala.Socket.assign(socket, :focused, false)}
  end

  def handle_info({:tap, :back}, socket) do
    {:noreply, Dala.Socket.pop_screen(socket)}
  end

  def handle_info(_message, socket), do: {:noreply, socket}

  defp header(title) do
    Dala.UI.text(text: title, text_size: :xl, text_color: :on_primary, background: :primary, padding: :space_md)
  end

  defp back_button do
    Dala.UI.button(text: "← Back", background: :surface_raised, text_color: :on_surface, text_size: :lg, padding: :space_sm, on_tap: {self(), :back})
  end
end
