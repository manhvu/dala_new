defmodule <%= module_name %>.TextScreen do
  @moduledoc "Text input demo screen."
  use Dala.Screen

  screen "text" do
    mount do
      socket =
        socket
        |> Dala.Socket.assign(:text, Dala.State.get(:draft_text, ""))
        |> Dala.Socket.assign(:focused, false)
      {:ok, socket}
    end

    scroll background: :background do
      column background: :background, padding: :space_md do
        header("✏️  Text Input")
        spacer size: 24

        # ── Input field ──────────────────────────────────────────────
        text_field value: assigns.text,
                    placeholder: "Type something…",
                    keyboard: :default,
                    return_key: :done,
                    on_change: {self(), :text_changed},
                    on_focus:  {self(), :focused},
                    on_blur:   {self(), :blurred}

        spacer size: 8
        text text: "@char_count character#{if assigns.char_count == 1, do: "", else: "s"}",
             text_size: :sm,
             text_color: :muted,
             padding: 4

        spacer size: 24
        divider color: :border
        spacer size: 16

        # ── Echo box ─────────────────────────────────────────────────
        text text: "Preview", text_size: :sm, text_color: :muted, padding: :space_sm
        box background: :surface_raised, padding: :space_md do
          text text: if(assigns.text == "", do: "Your text will appear here…", else: assigns.text),
               text_size: :lg,
               text_color: if(assigns.text == "", do: :muted, else: :on_surface),
               padding: 0
        end

        spacer size: 32
        back_button()
      end
    end

    handle_info({:change, :text_changed, value}, socket) do
      # Dala.State.put/2 syncs to disk on every call — fine for short text.
      # For heavier values, debounce writes using Process.send_after/3 instead.
      Dala.State.put(:draft_text, value)
      {:noreply, Dala.Socket.assign(socket, :text, value)}
    end

    handle_info({:focus, :focused}, socket) do
      {:noreply, Dala.Socket.assign(socket, :focused, true)}
    end

    handle_info({:blur, :blurred}, socket) do
      {:noreply, Dala.Socket.assign(socket, :focused, false)}
    end

    handle_info({:tap, :back}, socket) do
      {:noreply, Dala.Socket.pop_screen(socket)}
    end
  end

  def handle_info(_message, socket), do: {:noreply, socket}

  defp header(title) do
    text text: title, text_size: :xl, text_color: :on_primary, background: :primary, padding: :space_md
  end

  defp back_button do
    button text: "← Back", background: :surface_raised, text_color: :on_surface, text_size: :lg, padding: :space_sm, on_tap: {self(), :back}
  end
end
