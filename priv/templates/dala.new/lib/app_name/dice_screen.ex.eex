defmodule <%= module_name %>.DiceScreen do
  @moduledoc "Dice roller — tap to roll, tracks history and running average."
  use Dala.Spark.Dsl

  @faces %{1 => "⚀", 2 => "⚁", 3 => "⚂", 4 => "⚃", 5 => "⚄", 6 => "⚅"}
  @history_max 10

  dala do
    attributes do
      attribute :face, :string, default: ""
      attribute :value, :integer, default: 0
      attribute :history, :list, default: []
      attribute :total_rolls, :integer, default: 0
      attribute :total_pips, :integer, default: 0
      attribute :face_bg, :atom, default: :surface_raised
      attribute :face_fg, :atom, default: :muted
      attribute :face_text, :string, default: "？"
      attribute :roll_label, :string, default: "Roll!"
      attribute :avg_text, :string, default: "—"
      attribute :history_text, :string, default: ""
      attribute :history_count, :string, default: ""
    end

    screen do
      name :dice_roller
      scroll do
        background :background
        column do
          background :background
          padding :space_md
          text "🎲  Dice Roller", text_size: :xl, text_color: :on_primary, background: :primary, padding: :space_md
          spacer size: 32
          box do
            background :@face_bg
            padding :space_lg
            text "@face_text", text_size: 96.0, text_color: :@face_fg, padding: 0
          end
          spacer size: 24
          button "@roll_label", background: :primary, text_color: :on_primary, text_size: :xl, padding: :space_md, on_tap: :roll
          spacer size: 32
          divider color: :border
          spacer size: 16
          row do
            padding 0
            column do
              background :surface_raised
              padding :space_md
              text "@total_rolls", text_size: :xl, text_color: :primary, padding: 0
              text "Rolls", text_size: :sm, text_color: :muted, padding: 0
            end
            spacer size: 16
            column do
              background :surface_raised
              padding :space_md
              text "@avg_text", text_size: :xl, text_color: :primary, padding: 0
              text "Average", text_size: :sm, text_color: :muted, padding: 0
            end
          end
          column do
            padding 0
            text "@history_count", text_size: :sm, text_color: :muted, padding: :space_sm
            box do
              background :surface_raised
              padding :space_md
              text "@history_text", text_size: 28.0, text_color: :on_surface, padding: 0
            end
          end
          spacer size: 32
          button "← Back", background: :surface_raised, text_color: :on_surface, text_size: :lg, padding: :space_sm, on_tap: :back
        end
      end
    end
  end

  def handle_event(:roll, _params, socket) do
    value = :rand.uniform(6)
    face = Map.fetch!(@faces, value)
    history = [value | socket.assigns.history] |> Enum.take(@history_max)
    total_rolls = socket.assigns.total_rolls + 1
    total_pips = socket.assigns.total_pips + value
    avg = total_pips / total_rolls |> :erlang.float_to_binary(decimals: 2)
    history_emojis = history |> Enum.map(&Map.fetch!(@faces, &1)) |> Enum.join("  ")
    history_count = if length(history) > 0, do: "Last #{length(history)} rolls", else: ""

    {:noreply,
     Dala.Ui.Socket.assign(socket,
       value: value,
       face: face,
       history: history,
       total_rolls: total_rolls,
       total_pips: total_pips,
       face_bg: :primary,
       face_fg: :on_primary,
       face_text: face,
       roll_label: "Roll again",
       avg_text: avg,
       history_text: history_emojis,
       history_count: history_count
     )}
  end

  def handle_event(:back, _params, socket) do
    {:noreply, Dala.Ui.Socket.pop_screen(socket)}
  end
end
