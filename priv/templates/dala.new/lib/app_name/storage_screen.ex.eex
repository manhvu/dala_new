defmodule <%= module_name %>.StorageScreen do
  use Dala.Screen

  screen "storage" do
    mount do
      {:ok, Dala.Socket.assign(socket, status: "idle", files: [])}
    end

    scroll background: :background do
      column background: :background, padding: :space_lg do
        text text: "Storage", text_size: :lg, text_color: :on_surface, padding: :space_sm
        text text: "Status: @status", text_size: :sm, text_color: :primary, padding: 4
        spacer size: 16
        button text: "Write test file", background: :primary, text_color: :on_primary, padding: :space_md, fill_width: true, on_tap: {self(), :write}
        spacer size: 12
        button text: "List documents", background: :surface, text_color: :on_surface, padding: :space_md, fill_width: true, on_tap: {self(), :list}
        spacer size: 12
        button text: "Delete test file", background: :surface, text_color: :on_surface, padding: :space_md, fill_width: true, on_tap: {self(), :delete}
        spacer size: 20
        file_list(assigns.files)
      end
    end

    handle_info({:tap, :write}, socket) do
      path = Path.join(Dala.Storage.dir(:documents), "<%= app_name %>_test.txt")
      case Dala.Storage.write(path, "<%= display_name %> storage test\n#{DateTime.utc_now()}") do
        {:ok, _}        -> {:noreply, Dala.Socket.assign(socket, status: "written: #{Path.basename(path)}")}
        {:error, posix} -> {:noreply, Dala.Socket.assign(socket, status: "write error: #{posix}")}
      end
    end

    handle_info({:tap, :list}, socket) do
      case Dala.Storage.list(:documents) do
        {:ok, files}    -> {:noreply, Dala.Socket.assign(socket, files: files, status: "#{length(files)} file(s)")}
        {:error, posix} -> {:noreply, Dala.Socket.assign(socket, status: "list error: #{posix}")}
      end
    end

    handle_info({:tap, :delete}, socket) do
      path = Path.join(Dala.Storage.dir(:documents), "<%= app_name %>_test.txt")
      case Dala.Storage.delete(path) do
        :ok             -> {:noreply, Dala.Socket.assign(socket, status: "deleted")}
        {:error, posix} -> {:noreply, Dala.Socket.assign(socket, status: "delete error: #{posix}")}
      end
    end
  end

  def handle_info(_msg, socket), do: {:noreply, socket}

  defp file_list([]) do
    text text: "No files listed yet", text_size: :sm, text_color: :muted, padding: 4
  end
  defp file_list(files) do
    column padding: 0 do
      for f <- files do
        text text: Path.basename(f), text_size: :sm, text_color: :on_surface, padding: 4
      end
    end
  end
end
