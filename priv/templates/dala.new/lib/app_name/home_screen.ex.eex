defmodule <%= module_name %>.HomeScreen do
  @moduledoc "Landing screen for <%= display_name %>."
  use Dala.Screen

  def mount(_params, _session, socket) do
    theme = Dala.State.get(:theme, :obsidian)
    Dala.Theme.set(theme_to_module(theme))
    {:ok, Dala.Socket.assign(socket, :theme, theme)}
  end

  def render(assigns) do
    ~MOB"""
    <Scroll background={:background}>
      <Column background={:background} padding={:space_lg}>
        <Image src={logo_src(assigns.theme)} width={120} height={120} content_mode="fit" />
        <Spacer size={16} />
        <Text text="<%= display_name %>" text_size={:xl} text_color={:on_surface} padding={:space_sm} />
        <Text text="BEAM running on device" text_size={:sm} text_color={:primary} padding={4} />
        <Spacer size={40} />
        {nav_button("Text Input",          :open_text)}
        <Spacer size={12} />
        {nav_button("Rock Paper Scissors", :open_list)}
        <Spacer size={12} />
        {nav_button("Roll Dice",           :open_dice)}
        <Spacer size={12} />
        {nav_button("WebView",             :open_webview)}
        <Spacer size={12} />
        {nav_button("Audio",               :open_audio)}
        <Spacer size={12} />
        {nav_button("Camera",              :open_camera)}
        <Spacer size={12} />
        {nav_button("Storage",             :open_storage)}
        <Spacer size={32} />
        <Text text="Theme" text_size={:sm} text_color={:muted} padding={4} />
        <Spacer size={8} />
        <Row fill_width={true}>
          {theme_tab("Obsidian", :obsidian, assigns.theme)}
          <Spacer size={8} />
          {theme_tab("Citrus",   :citrus,   assigns.theme)}
          <Spacer size={8} />
          {theme_tab("Birch",    :birch,    assigns.theme)}
        </Row>
      </Column>
    </Scroll>
    """
  end

  def handle_info({:tap, :open_text}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.TextScreen)}
  end

  def handle_info({:tap, :open_list}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.ListScreen)}
  end

  def handle_info({:tap, :open_dice}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.DiceScreen)}
  end

  def handle_info({:tap, :open_webview}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.WebViewScreen)}
  end

  def handle_info({:tap, :open_audio}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.AudioScreen)}
  end

  def handle_info({:tap, :open_camera}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.CameraScreen)}
  end

  def handle_info({:tap, :open_storage}, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.StorageScreen)}
  end

  def handle_info({:tap, :theme_obsidian}, socket) do
    Dala.Theme.set(Dala.Theme.Obsidian)
    Dala.State.put(:theme, :obsidian)
    {:noreply, Dala.Socket.assign(socket, :theme, :obsidian)}
  end

  def handle_info({:tap, :theme_citrus}, socket) do
    Dala.Theme.set(Dala.Theme.Citrus)
    Dala.State.put(:theme, :citrus)
    {:noreply, Dala.Socket.assign(socket, :theme, :citrus)}
  end

  def handle_info({:tap, :theme_birch}, socket) do
    Dala.Theme.set(Dala.Theme.Birch)
    Dala.State.put(:theme, :birch)
    {:noreply, Dala.Socket.assign(socket, :theme, :birch)}
  end

  def handle_info(_message, socket), do: {:noreply, socket}

  defp nav_button(label, tag) do
    tap = {self(), tag}
    ~MOB(<Button text={label} background={:primary} text_color={:on_primary} text_size={:lg} padding={:space_md} fill_width={true} on_tap={tap} />)
  end

  defp theme_tab(label, key, active) do
    {bg, fg} = if key == active, do: {:primary, :on_primary}, else: {:surface, :on_surface}
    tap = {self(), :"theme_#{key}"}
    ~MOB(<Button text={label} background={bg} text_color={fg} text_size={:sm} padding={:space_sm} weight={1} on_tap={tap} />)
  end

  defp theme_to_module(:citrus), do: Dala.Theme.Citrus
  defp theme_to_module(:birch),  do: Dala.Theme.Birch
  defp theme_to_module(_),       do: Dala.Theme.Obsidian

  defp logo_src(:birch), do: Path.join(rootdir(), "dala_logo_dark.png")
  defp logo_src(_),      do: Path.join(rootdir(), "dala_logo_light.png")

  # ROOTDIR is set by dala_beam (iOS) and dala_beam.c (Android) before erl_start,
  # so this fallback is only exercised in unit tests on the host. Don't put
  # `Path.expand("~/...")` directly in `System.get_env/2`'s default argument —
  # default args evaluate eagerly, and Android's BEAM has no `HOME` env var,
  # so `System.user_home!()` would raise `RuntimeError` and abort the screen
  # before the first render.
  defp rootdir do
    case System.get_env("ROOTDIR") do
      nil -> Path.expand("~/.dala/runtime/ios-sim")
      val -> val
    end
  end
end
