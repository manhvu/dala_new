defmodule <%= module_name %>.HomeScreen do
  @moduledoc "Landing screen for <%= display_name %>."
  use Dala.Screen

  def mount(_params, _session, socket) do
    theme = Dala.Platform.State.get(:theme, :obsidian)
    {:ok, Dala.Socket.assign(socket, :theme, theme)}
  end

  def render(assigns) do
    Dala.Ui.Widgets.scroll([background: :background], [
      Dala.Ui.Widgets.column([background: :background, padding: :space_lg], [
        Dala.Ui.Widgets.text(text: "<%= display_name %>", text_size: :xl, text_color: :on_surface, padding: :space_sm),
        Dala.Ui.Widgets.text(text: "BEAM running on device", text_size: :sm, text_color: :primary, padding: 4),
        Dala.Ui.Widgets.spacer(size: 40),
        Dala.Ui.Widgets.button(text: "Text Input", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_text),
        Dala.Ui.Widgets.spacer(size: 12),
        Dala.Ui.Widgets.button(text: "Rock Paper Scissors", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_list),
        Dala.Ui.Widgets.spacer(size: 12),
        Dala.Ui.Widgets.button(text: "Roll Dice", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_dice),
        Dala.Ui.Widgets.spacer(size: 12),
        Dala.Ui.Widgets.button(text: "WebView", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_webview),
        Dala.Ui.Widgets.spacer(size: 12),
        Dala.Ui.Widgets.button(text: "Audio", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_audio),
        Dala.Ui.Widgets.spacer(size: 12),
        Dala.Ui.Widgets.button(text: "Camera", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_camera),
        Dala.Ui.Widgets.spacer(size: 12),
        Dala.Ui.Widgets.button(text: "Storage", background: :primary, text_color: :on_primary, text_size: :lg, padding: :space_md, fill_width: true, on_tap: :open_storage),
        Dala.Ui.Widgets.spacer(size: 32),
        Dala.Ui.Widgets.text(text: "Theme", text_size: :sm, text_color: :muted, padding: 4),
        Dala.Ui.Widgets.spacer(size: 8),
        Dala.Ui.Widgets.row([fill_width: true], [
          Dala.Ui.Widgets.button(text: "Obsidian", background: :primary, text_color: :on_primary, text_size: :sm, padding: :space_sm, fill_width: true, on_tap: :theme_obsidian),
          Dala.Ui.Widgets.spacer(size: 8),
          Dala.Ui.Widgets.button(text: "Citrus", background: :surface, text_color: :on_surface, text_size: :sm, padding: :space_sm, fill_width: true, on_tap: :theme_citrus),
          Dala.Ui.Widgets.spacer(size: 8),
          Dala.Ui.Widgets.button(text: "Birch", background: :surface, text_color: :on_surface, text_size: :sm, padding: :space_sm, fill_width: true, on_tap: :theme_birch)
        ])
      ])
    ])
  end

  def handle_event(:open_text, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.TextScreen)}
  end

  def handle_event(:open_list, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.ListScreen)}
  end

  def handle_event(:open_dice, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.DiceScreen)}
  end

  def handle_event(:open_webview, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.WebViewScreen)}
  end

  def handle_event(:open_audio, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.AudioScreen)}
  end

  def handle_event(:open_camera, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.CameraScreen)}
  end

  def handle_event(:open_storage, _params, socket) do
    {:noreply, Dala.Socket.push_screen(socket, <%= module_name %>.StorageScreen)}
  end

  def handle_event(:theme_obsidian, _params, socket) do
    Dala.Theme.set(Dala.Theme.Obsidian)
    Dala.Platform.State.put(:theme, :obsidian)
    {:noreply, Dala.Socket.assign(socket, :theme, :obsidian)}
  end

  def handle_event(:theme_citrus, _params, socket) do
    Dala.Theme.set(Dala.Theme.Citrus)
    Dala.Platform.State.put(:theme, :citrus)
    {:noreply, Dala.Socket.assign(socket, :theme, :citrus)}
  end

  def handle_event(:theme_birch, _params, socket) do
    Dala.Theme.set(Dala.Theme.Birch)
    Dala.Platform.State.put(:theme, :birch)
    {:noreply, Dala.Socket.assign(socket, :theme, :birch)}
  end
end
